## Root directory
## ignore files generated by R when setting up a project in the git repository
/*.Rproj.user
/*.Rhistory
/*.RData
/*.Ruserdata
/*.Rproj

## ignore files generated by MacOS when setting up a project in the git repository
.DS_Store

## Code directory
## ignore any junk created in code folder generated by Rstudio
code/*.rds
code/*.Rdata
code/*.RData
code/*.Rhistory
code/*.Rproj.user
code/*.Rproj
## including files generated by caching a knitted markdown
code/*.rdb
code/*.rdx

## Data directory
## Raw and intermediate data are excluded; documentation and metadata remain tracked.
versions
data/raw
data/intermediate
.Rproj.user

## renv local state
renv/library/
renv/staging/
renv/local/

## Rendered documents and notebooks
writing/*.docx
!writing/docx_template.docx
writing/*.html
writing/*.pdf
writing/*_files/
results/**/*.html
results/**/*_files/
